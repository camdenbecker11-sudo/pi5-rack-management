# Timezone
TZ=America/New_York
HOSTNAME=pi5-rack

# Domain and SSL
DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com

# Traefik Auth (generate with: htpasswd -nB admin | sed 's/\$/\$\$/g')
TRAEFIK_USER=admin:$$2y$$05$$example
TRAEFIK_PASSWORD=

# Tailscale
TAILSCALE_AUTHKEY=tskey-xxxxxxxxxxxxx
TAILSCALE_HOSTNAME=pi5-rack

# AdGuard
ADGUARD_USER=admin
ADGUARD_PASS=change-this-password

# Portainer
PORTAINER_PORT=9000

# Home Assistant
HOMEASSISTANT_PORT=8123

# Uptime Kuma
UPTIMEKUMA_PORT=3001

# Grafana
GRAFANA_PORT=3002
GRAFANA_PASSWORD=change-this-password

# Prometheus
PROMETHEUS_PORT=9090

# NetBox
NETBOX_PORT=8000
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=change-this-password
NETBOX_SECRET_KEY=change-this-secret-key

# Dashboard
DASHBOARD_PORT=8081

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=daily
