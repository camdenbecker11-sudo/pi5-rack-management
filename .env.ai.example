# AI Stack Configuration for Pi 5
# Copy this to .env and edit the values

TZ=America/New_York
HOSTNAME=pi5-ai-rack

# PostgreSQL with pgvector for embeddings
POSTGRES_DB=aihub
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Redis for caching and sessions
REDIS_PASSWORD=your-secure-redis-password-here

# MinIO for S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password-here

# Ollama local model runtime
OLLAMA_PORT=11434

# Open WebUI for chat interface
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_SECRET_KEY=your-secure-webui-secret-key-here

# FileBrowser for file management
FILEBROWSER_PORT=8081

# Tailscale for secure remote access (optional)
TAILSCALE_AUTHKEY=tskey-xxxxxxxxxxxxx
TAILSCALE_HOSTNAME=pi5-ai-rack

# Backup settings
BACKUP_RETENTION_DAYS=30
